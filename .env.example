# Environment Configuration for Applyon Backend
APP_ENV=development
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL with pgvector)
# For local dev via Docker Compose:
DATABASE_URL=postgresql+asyncpg://applyon:applyon_secret@localhost:5432/applyon
DIRECT_DATABASE_URL=postgresql://applyon:applyon_secret@localhost:5432/applyon
# For Supabase connection pooler (port 6543):
# DATABASE_URL=postgresql+asyncpg://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres
# DIRECT_DATABASE_URL=postgresql://postgres:[db-password]@db.[project-ref].supabase.co:5432/postgres

# Redis (Queues, Cache, Token Bucket, Rate Limits)
REDIS_URL=redis://localhost:6379/0

# Authentication & Cloud Storage: Firebase
FIREBASE_PROJECT_ID=applyon-dev
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Supabase Auth & Storage (Alternative / Fallback)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=

# AI: Google Gemini
GEMINI_API_KEY=
# Model names change; check what your key can use: GET https://generativelanguage.googleapis.com/v1beta/models?key=...
# A Pro model (e.g. gemini-pro-latest) gives better tailoring but needs a paid quota.
GEMINI_MODEL_LITE=gemini-3.1-flash-lite
GEMINI_MODEL_FAST=gemini-3.5-flash
GEMINI_MODEL_SMART=gemini-3.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
# Tried in order when a model is overloaded or out of free quota (each model has its own quota)
GEMINI_FALLBACK_MODELS=["gemini-3.5-flash-lite","gemini-3-flash-preview"]

# Job Ingestion
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# JSearch by OpenWebNinja (https://app.openwebninja.com/api/jsearch)
JSEARCH_API_KEY=
CRAWLER_USER_AGENT=ApplyonBot/1.0 (+https://applyon.in/bot)

# Transactional Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=onboarding@applyon.in

# Payments (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Security & Encryption
# Generate a Fernet key via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=J9NkJw6P4v0sXU3Z7Bq1W8e5R2tY4u6I8o0pAaBbCc=
JWT_SECRET_KEY=applyon-local-dev-jwt-secret-replace-in-production

# Observability
SENTRY_DSN=
EXTENSION_ID=

# ---------------------------------------------------------------------------
# Front end (Next.js) — copy these into .env.local
# ---------------------------------------------------------------------------
# FastAPI backend base URL (no trailing slash)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Firebase web app config (Firebase console → Project settings → Your apps → Web app).
# Leave empty for local "dev login", which works only against a backend with APP_ENV=development.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
