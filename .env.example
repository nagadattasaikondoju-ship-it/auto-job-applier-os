# Environment Configuration for Applyon Backend
APP_ENV=development
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL with pgvector)
# For local dev via Docker Compose:
DATABASE_URL=postgresql+asyncpg://applyon:applyon_secret@localhost:5432/applyon
DIRECT_DATABASE_URL=postgresql://applyon:applyon_secret@localhost:5432/applyon
# For Supabase connection pooler (port 6543):
# DATABASE_URL=postgresql+asyncpg://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres
# DIRECT_DATABASE_URL=postgresql://postgres:[db-password]@db.[project-ref].supabase.co:5432/postgres

# Redis (Queues, Cache, Token Bucket, Rate Limits)
REDIS_URL=redis://localhost:6379/0

# Authentication & Cloud Storage: Firebase
FIREBASE_PROJECT_ID=applyon-dev
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Supabase Auth & Storage (Alternative / Fallback)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=

# AI: Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL_LITE=gemini-1.5-flash-8b
GEMINI_MODEL_FAST=gemini-1.5-flash
GEMINI_MODEL_SMART=gemini-1.5-pro
GEMINI_EMBED_MODEL=text-embedding-004

# Job Ingestion
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
CRAWLER_USER_AGENT=ApplyonBot/1.0 (+https://applyon.in/bot)

# Transactional Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=onboarding@applyon.in

# Payments (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Security & Encryption
# Generate a Fernet key via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=J9NkJw6P4v0sXU3Z7Bq1W8e5R2tY4u6I8o0pAaBbCc=
JWT_SECRET_KEY=applyon-local-dev-jwt-secret-replace-in-production

# Observability
SENTRY_DSN=
EXTENSION_ID=
